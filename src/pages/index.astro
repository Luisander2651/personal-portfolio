---
import { getCollection, getEntry } from 'astro:content';
import AboutSection from '../components/AboutSection.astro';
import CardSpotlight from '../components/CardSpotlight.astro';
import EducationSection from '../components/EducationSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import HomeHero from '../components/HomeHero.astro';
import LanguagesSection from '../components/LanguagesSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import SectionReveal from '../components/SectionReveal.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import TechStackSection from '../components/TechStackSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageMeta } from '../lib/page-meta';
import { groupProjectsForSection } from '../lib/projects';
import { groupSkillsForSection } from '../lib/skills';

const profile = await getEntry('profile', 'profile');
if (!profile) {
  throw new Error('Missing profile entry: src/content/profile/profile.md');
}

const { title, description } = getPageMeta(profile.data);
const site = Astro.site;
if (!site) {
  throw new Error('Missing `site` in astro.config.mjs');
}
const {
  name,
  role,
  location,
  featuredStack,
  github,
  linkedin,
  email,
  summary,
  practicalExperience,
  focusAreas,
  languages,
} = profile.data;
const skillGroups = groupSkillsForSection(await getCollection('skills'));
const projectGroups = groupProjectsForSection(await getCollection('projects'));
const experiences = await getCollection('experience');
const education = await getCollection('education');
/** Year of the build, for the footer copyright (specs/011-footer, CA-1.3). */
const buildYear = new Date().getFullYear();
---

<BaseLayout
  title={title}
  description={description}
  seo={{ profile: { name, role, location, email, github, linkedin }, site }}
>
  <SiteNav name={name} />
  <main id="contenido">
    <HomeHero
      name={name}
      role={role}
      location={location}
      featuredStack={featuredStack}
      github={github}
      linkedin={linkedin}
      email={email}
    />
    <AboutSection summary={summary} practicalExperience={practicalExperience} focusAreas={focusAreas} />
    <TechStackSection icons={skillGroups.icons} tags={skillGroups.tags} text={skillGroups.text} />
    <ProjectsSection featured={projectGroups.featured} rest={projectGroups.rest} />
    <ExperienceSection experiences={experiences} />
    <EducationSection entries={education} />
    <LanguagesSection languages={languages} />
    <SectionReveal />
    <CardSpotlight />
  </main>
  <SiteFooter name={name} role={role} email={email} github={github} linkedin={linkedin} year={buildYear} />
</BaseLayout>
