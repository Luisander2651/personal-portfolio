---
import { getEntry } from 'astro:content';
import HomeHero from '../components/HomeHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageMeta } from '../lib/page-meta';

const profile = await getEntry('profile', 'profile');
if (!profile) {
  throw new Error('Missing profile entry: src/content/profile/profile.md');
}

const { title, description } = getPageMeta(profile.data);
const { name, role, location, featuredStack, github, linkedin, email } = profile.data;
---

<BaseLayout title={title} description={description}>
  <main>
    <HomeHero
      name={name}
      role={role}
      location={location}
      featuredStack={featuredStack}
      github={github}
      linkedin={linkedin}
      email={email}
    />
  </main>
</BaseLayout>
