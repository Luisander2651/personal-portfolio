---
import { getEntry } from 'astro:content';
import ProfileHeading from '../components/ProfileHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageMeta } from '../lib/page-meta';

const profile = await getEntry('profile', 'profile');
if (!profile) {
  throw new Error('Missing profile entry: src/content/profile/profile.md');
}

const { title, description } = getPageMeta(profile.data);
---

<BaseLayout title={title} description={description}>
  <main>
    <ProfileHeading name={profile.data.name} role={profile.data.role} />
  </main>
</BaseLayout>
