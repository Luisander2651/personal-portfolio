---
import { buildProfileCodeLines } from '../lib/hero-code';
import ContactIcon from './ContactIcon.astro';

interface Props {
  name: string;
  role: string;
  location: string;
  featuredStack: readonly string[];
  github: string;
  linkedin: string;
  email: string;
}

const { name, role, location, featuredStack, github, linkedin, email } = Astro.props;

const codeLines = buildProfileCodeLines({ name, role, featuredStack });

const links = [
  { label: 'GitHub', href: github, icon: 'github' },
  { label: 'LinkedIn', href: linkedin, icon: 'linkedin' },
  { label: 'Correo', href: `mailto:${email}`, icon: 'mail' },
] as const;
---

<section class="hero" aria-labelledby="hero-name">
  <script is:inline>
    // M-1 pre-paint mark: hides the card before it is painted, only when the animation will run.
    (() => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const root = document.documentElement;
      const styles = getComputedStyle(root);
      const total = ['--duration-hero-type', '--duration-hero-compile', '--duration-reveal', '--duration-scramble']
        .map((token) => styles.getPropertyValue(token).trim())
        .reduce((sum, value) => sum + parseFloat(value) * (value.endsWith('ms') ? 1 : 1000), 0);
      root.dataset.heroMotion = 'pending';
      // Fallback: if the animation has not started in time, show the static card.
      setTimeout(() => {
        if (root.dataset.heroMotion === 'pending') delete root.dataset.heroMotion;
      }, total);
    })();
  </script>
  <div class="hero-slot">
    <pre class="hero-code" aria-hidden="true" hidden><code><span class="hero-caret"></span>{codeLines.map((line) => <span class="code-line">{line.map(({ text, kind }) => <span class={`code-${kind}`}>{text}</span>)}</span>)}</code></pre>

    <article class="hero-card">
      <div class="hero-meta">
        <span class="hero-location">{location}</span>
        <span class="hero-indicator" aria-hidden="true">render(profile)</span>
      </div>
      <div class="hero-identity">
        <h1 id="hero-name">{name}</h1>
        <p class="hero-role">{role}</p>
      </div>
      <ul class="hero-stack">
        {featuredStack.map((technology) => <li>{technology}</li>)}
      </ul>
      <div class="hero-links">
        {
          links.map(({ label, href, icon }) => (
            <a class="hero-link" href={href} aria-label={label}>
              <ContactIcon name={icon} />
            </a>
          ))
        }
      </div>
    </article>
  </div>
</section>

<style>
  /* Composition A · "Escenario" (designs/003-home-hero/design.md). Tokens only. */
  .hero {
    box-sizing: border-box;
    min-height: var(--hero-min-height);
    display: grid;
    place-items: center;
    padding-block: var(--space-gutter);
    padding-inline: var(--space-gutter);
  }

  /* The card defines the slot size; the decorative code overlays the same slot. */
  .hero-slot {
    position: relative;
    width: 100%;
    max-width: var(--hero-card-max-width);
  }

  .hero-code {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    margin: 0;
    overflow: hidden;
    padding: var(--code-padding);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-sunken);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-code-size);
    line-height: var(--text-code-line-height);
    white-space: pre-wrap;
  }

  .hero-code[hidden] {
    display: none;
  }

  .hero-code code {
    font: inherit;
  }

  .code-line {
    display: block;
  }

  .hero-caret {
    display: inline-block;
    width: var(--hero-caret-width);
    height: var(--hero-caret-height);
    margin-inline-start: var(--space-1);
    vertical-align: middle;
    background-color: var(--color-glow);
  }

  .code-keyword {
    color: var(--color-code-keyword);
  }

  .code-string {
    color: var(--color-code-string);
  }

  .code-function {
    color: var(--color-code-function);
  }

  .hero-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: var(--hero-card-gap);
    padding: var(--hero-card-padding);
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(var(--color-surface), var(--color-surface)) padding-box,
      var(--border-glow) border-box;
    box-shadow: var(--shadow-glow-hero);
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .hero-location {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label-size);
    line-height: var(--text-mono-label-line-height);
    font-weight: var(--text-mono-label-weight);
    letter-spacing: var(--text-mono-label-tracking);
    text-transform: var(--text-mono-label-transform);
    color: var(--color-text-muted);
  }

  .hero-indicator {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--tag-font-size);
    color: var(--color-code-function);
  }

  .hero-identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hero-identity h1 {
    margin: 0;
    text-wrap: balance;
  }

  .hero-role {
    margin: 0;
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-line-height);
    font-weight: var(--text-body-weight);
    color: var(--color-text-secondary);
  }

  .hero-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-stack li {
    display: inline-flex;
    align-items: center;
    height: var(--tag-height);
    padding-inline: var(--tag-padding-x);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    font-family: var(--font-mono);
    font-size: var(--tag-font-size);
    font-weight: var(--text-mono-label-weight);
    line-height: 1;
  }

  .hero-links {
    display: flex;
    gap: var(--space-3);
    padding-top: var(--hero-card-gap);
    border-top: var(--border-width) solid var(--color-border);
  }

  /* M-3: the luminous border is a gradient layer that fades in (gradients cannot transition);
     an inner fill (::after) keeps it visible only as a ring. */
  .hero-link {
    position: relative;
    isolation: isolate;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-frame-size);
    height: var(--icon-frame-size);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    background-clip: padding-box;
    color: var(--color-text-secondary);
    transition:
      color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .hero-link::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--border-width));
    z-index: -1;
    border-radius: inherit;
    background: var(--border-glow);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  /* Inner fill above the glow layer, so the gradient only shows as a border ring. */
  .hero-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: calc(var(--radius-md) - var(--border-width));
    background-color: var(--color-surface);
  }

  /* The icon lives in ContactIcon, outside this component's scope. */
  .hero-link :global(.contact-icon) {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    stroke-width: var(--icon-stroke);
  }

  .hero-link:focus-visible {
    color: var(--color-text);
    border-color: transparent;
    box-shadow: var(--shadow-glow-soft);
  }

  .hero-link:focus-visible::before {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-link:hover {
      color: var(--color-text);
      border-color: transparent;
      box-shadow: var(--shadow-glow-soft);
    }

    .hero-link:hover::before {
      opacity: 1;
    }
  }

  @media (hover: none) {
    .hero-link:active {
      color: var(--color-text);
      border-color: transparent;
      box-shadow: var(--shadow-glow-soft);
    }

    .hero-link:active::before {
      opacity: 1;
    }
  }

  @media (min-width: 768px) {
    .hero-indicator {
      display: inline;
    }
  }

  /* M-1 initial state, only while the inline script marks the document. Without JavaScript or
     with reduced motion the mark never exists and the card is shown directly. */
  :global(html[data-hero-motion]) .hero-code[hidden] {
    display: block;
  }

  :global(html[data-hero-motion]) .code-line {
    opacity: 0;
  }

  :global(html[data-hero-motion]) .hero-card {
    opacity: 0;
    transform: translateY(var(--hero-card-distance));
  }
</style>

<script>
  import { parseCssDuration, scrambleText } from '../lib/hero-motion';

  const SCRAMBLE_GLYPHS = '<>/{}[]=+*_#$01';

  const root = document.documentElement;
  const hero = document.querySelector<HTMLElement>('.hero');
  const heading = hero?.querySelector<HTMLElement>('h1');

  if (hero && heading && root.dataset.heroMotion === 'pending') {
    root.dataset.heroMotion = 'running';
    const name = heading.textContent ?? '';

    playHeroMotion(hero, heading, name)
      // Any failure falls back to the static card below.
      .catch(() => {})
      .finally(() => {
        delete root.dataset.heroMotion;
        heading.textContent = name;
        heading.removeAttribute('aria-label');
        heading.style.removeProperty('height');
        for (const animation of hero.getAnimations({ subtree: true })) animation.cancel();
      });
  }

  async function playHeroMotion(hero: HTMLElement, heading: HTMLElement, name: string): Promise<void> {
    const code = hero.querySelector<HTMLElement>('.hero-code');
    const card = hero.querySelector<HTMLElement>('.hero-card');
    const caret = hero.querySelector<HTMLElement>('.hero-caret');
    if (!code || !card || !caret) throw new Error('Hero motion elements not found');

    const styles = getComputedStyle(root);
    const token = (property: string) => styles.getPropertyValue(property).trim();
    const duration = (property: string) => parseCssDuration(token(property));

    // F1 · typing: each line gets an equal share of the typing time and fades in over the stagger.
    const lines = [...code.querySelectorAll<HTMLElement>('.code-line')];
    const lineTime = duration('--duration-hero-type') / lines.length;
    const fadeOffset = Math.min(duration('--stagger') / lineTime, 1);
    for (const line of lines) {
      line.append(caret);
      await line.animate([{ opacity: 0 }, { opacity: 1, offset: fadeOffset }, { opacity: 1 }], {
        duration: lineTime,
        fill: 'forwards',
      }).finished;
    }

    // F2 · compiling.
    await code.animate(
      [
        {
          filter: `blur(${token('--hero-compile-blur')}) brightness(${token('--hero-compile-brightness')})`,
          borderColor: token('--color-glow'),
          boxShadow: token('--shadow-glow-hero'),
        },
      ],
      { duration: duration('--duration-hero-compile'), easing: token('--ease-in-out'), fill: 'forwards' },
    ).finished;

    // F3 · the card replaces the code.
    const reveal: KeyframeAnimationOptions = {
      duration: duration('--duration-reveal'),
      easing: token('--ease-out'),
      fill: 'forwards',
    };
    code.animate([{ opacity: 0 }], reveal);
    await card.animate(
      [{ opacity: 0, transform: `translateY(${token('--hero-card-distance')})` }, { opacity: 1, transform: 'none' }],
      reveal,
    ).finished;

    // M-2 · name decode; assistive technology keeps reading the real name. The heading keeps its
    // measured height so glyphs wider or narrower than the name never shift the layout.
    heading.setAttribute('aria-label', name);
    heading.style.height = `${heading.getBoundingClientRect().height}px`;
    const scrambleTime = duration('--duration-scramble');
    const randomGlyph = () => SCRAMBLE_GLYPHS[Math.floor(Math.random() * SCRAMBLE_GLYPHS.length)] ?? '';
    await new Promise<void>((resolve) => {
      const start = performance.now();
      const frame = (now: number) => {
        const progress = scrambleTime > 0 ? (now - start) / scrambleTime : 1;
        heading.textContent = scrambleText(name, progress, randomGlyph);
        if (progress < 1) requestAnimationFrame(frame);
        else resolve();
      };
      requestAnimationFrame(frame);
    });
  }
</script>
