---
interface Props {
  /** Section anchor without `#`, shown in the decorative path. */
  anchor: string;
  title: string;
  headingId: string;
}

const { anchor, title, headingId } = Astro.props;
---

<header class="section-header" data-reveal>
  <p class="section-header-path" aria-hidden="true">
    <span>portfolio</span><span class="section-header-separator">/</span><span class="section-header-anchor">{anchor}</span>
  </p>
  <h2 id={headingId}>{title}</h2>
</header>

<style>
  /* "Encabezado de sección" (designs/000-design-system/design.md). Tokens only. */
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section-header-path {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono-label-size);
    line-height: var(--text-mono-label-line-height);
    font-weight: var(--text-mono-label-weight);
    letter-spacing: var(--text-mono-label-tracking);
    text-transform: var(--text-mono-label-transform);
    color: var(--color-text-muted);
  }

  .section-header-separator {
    color: var(--color-border-strong);
  }

  .section-header-anchor {
    color: var(--color-text-secondary);
  }

  .section-header h2 {
    margin: 0;
  }
</style>
