---
/*
 * P-2 spotlight (designs/000-design-system/design.md), shared by the cards of every section:
 * cards marked with `data-spotlight` get a light that follows a fine pointer, a glow border and
 * a soft shadow while the pointer is inside (`data-spotlight-active`). Rendered once on the page;
 * each section only adds its own color changes for the active state. Without JavaScript, with
 * reduced motion or on touch there is no light.
 */
---

<script>
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (finePointer && !reducedMotion) {
    for (const card of document.querySelectorAll<HTMLElement>('[data-spotlight]')) {
      let pointerX = 0;
      let pointerY = 0;
      let frame = 0;

      const place = () => {
        frame = 0;
        const { left, top } = card.getBoundingClientRect();
        card.style.setProperty('--spotlight-x', `${pointerX - left}px`);
        card.style.setProperty('--spotlight-y', `${pointerY - top}px`);
      };
      const track = (event: PointerEvent) => {
        pointerX = event.clientX;
        pointerY = event.clientY;
      };

      card.addEventListener('pointerenter', (event) => {
        track(event);
        place();
        card.dataset.spotlightActive = '';
      });
      card.addEventListener('pointermove', (event) => {
        track(event);
        frame ||= requestAnimationFrame(place);
      });
      card.addEventListener('pointerleave', () => {
        cancelAnimationFrame(frame);
        frame = 0;
        delete card.dataset.spotlightActive;
      });
    }
  }
</script>

<style is:global>
  /* Fine pointers only. Transitions live on the layers, never on the card: the shared reveal owns
     the card's own transition. */
  @media (hover: hover) and (pointer: fine) {
    [data-spotlight] {
      position: relative;
      isolation: isolate;
    }

    /* Glow layer: the surface fills the padding box, so the gradient shows as the border. */
    [data-spotlight]::before {
      content: '';
      position: absolute;
      inset: calc(-1 * var(--border-width));
      z-index: -1;
      border: var(--border-width) solid transparent;
      border-radius: inherit;
      background:
        linear-gradient(var(--color-surface), var(--color-surface)) padding-box,
        var(--border-glow) border-box;
      box-shadow: var(--shadow-glow-soft);
      opacity: 0;
      pointer-events: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      /* Light layer, centered on the pointer position set by the script. */
      [data-spotlight]::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: calc(var(--radius-lg) - var(--border-width));
        background: radial-gradient(
          circle var(--spotlight-size) at var(--spotlight-x) var(--spotlight-y),
          var(--color-spotlight),
          transparent
        );
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--duration-base) var(--ease-out);
      }

      [data-spotlight]::before {
        transition: opacity var(--duration-base) var(--ease-out);
      }

      [data-spotlight][data-spotlight-active]::before,
      [data-spotlight][data-spotlight-active]::after {
        opacity: 1;
      }
    }

    /* Reduced motion: no light, static glow border on hover. */
    @media (prefers-reduced-motion: reduce) {
      [data-spotlight]:hover::before {
        opacity: 1;
      }
    }
  }
</style>
