---
/*
 * P-1 section reveal (designs/000-design-system/design.md): blocks marked with `data-reveal`
 * fade and rise in once their top edge has entered `--reveal-start-distance` (or they are fully
 * visible), and hide again when they leave the viewport. Rendered once on the page; without
 * JavaScript or with reduced motion nothing is hidden.
 */
---

<script>
  import { planRevealChanges } from '../lib/section-reveal';

  const blocks = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion && blocks.length > 0 && 'IntersectionObserver' in window) {
    const root = document.documentElement;
    const startDistance = () => parseFloat(getComputedStyle(root).getPropertyValue('--reveal-start-distance')) || 0;
    const plan = (targets: readonly HTMLElement[]) =>
      planRevealChanges(
        targets.map((target) => {
          const { top, bottom, left } = target.getBoundingClientRect();
          return { target, top, bottom, left };
        }),
        { height: window.innerHeight, startDistance: startDistance() },
      );

    // Blocks that already count as revealed are shown as they are, so activating never flashes them.
    for (const block of plan(blocks).reveal) block.dataset.reveal = 'shown';
    root.dataset.revealReady = '';

    const update = (entries: IntersectionObserverEntry[]) => {
      const { reveal, hide } = plan(entries.map((entry) => entry.target as HTMLElement));
      for (const block of hide) {
        block.dataset.reveal = 'hidden';
        block.style.removeProperty('--reveal-order');
      }
      let order = 0;
      for (const block of reveal) {
        if (block.dataset.reveal === 'shown') continue;
        block.style.setProperty('--reveal-order', String(order++));
        block.dataset.reveal = 'shown';
      }
    };

    // Entering: the top edge crosses the start distance. Fully visible and leaving: no margin.
    const entering = new IntersectionObserver(update, { rootMargin: `0px 0px -${startDistance()}px 0px` });
    const visibility = new IntersectionObserver(update, { threshold: [0, 1] });
    for (const block of blocks) {
      entering.observe(block);
      visibility.observe(block);
    }
  }
</script>

<style is:global>
  /* Hidden state only while the reveal script is active. */
  html[data-reveal-ready] [data-reveal]:not([data-reveal='shown']) {
    opacity: 0;
    transform: translateY(var(--reveal-distance));
  }

  /* Only entering animates; going back to hidden is instant (the block is off screen). */
  html[data-reveal-ready] [data-reveal='shown'] {
    transition:
      opacity var(--duration-reveal) var(--ease-out),
      transform var(--duration-reveal) var(--ease-out);
    transition-delay: calc(var(--stagger) * var(--reveal-order, 0));
  }
</style>
