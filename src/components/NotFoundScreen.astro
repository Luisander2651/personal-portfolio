---
/*
 * 404 screen, direction A · "Señal" (designs/013-not-found-page/design.md): the code, the
 * heading, one line and the link back to the home. The code is decoded on load by the script
 * added in T04; without JavaScript it reads "404" already.
 */
const CODE = '404';
---

<div class="not-found">
  <p class="not-found-code" aria-label={CODE}><span class="not-found-code-text" aria-hidden="true">{CODE}</span></p>
  <div class="not-found-message">
    <h1>Página no encontrada</h1>
    <p class="not-found-line">La ruta que buscas no existe o se ha movido.</p>
  </div>
  <a class="not-found-link" href="/">
    <svg class="not-found-arrow" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M13 8H3M7 4L3 8l4 4"></path>
    </svg>
    Volver al inicio
  </a>
</div>

<script>
  /* M-1 · decode of the code (designs/013-not-found-page/design.md, P-4). Only the decorative
     text changes: the paragraph keeps `aria-label="404"`, so assistive technology reads "404". */
  import { parseCssDuration, scrambleText } from '../lib/hero-motion';

  const GLYPHS = '<>/{}[]=+*_#$01';
  const text = document.querySelector<HTMLElement>('.not-found-code-text');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (text && !reducedMotion) {
    const code = text.textContent ?? '';
    const scrambleTime = parseCssDuration(getComputedStyle(document.documentElement).getPropertyValue('--duration-scramble'));
    const randomGlyph = () => GLYPHS[Math.floor(Math.random() * GLYPHS.length)] ?? '';
    const start = performance.now();
    const frame = (now: number) => {
      const progress = scrambleTime > 0 ? (now - start) / scrambleTime : 1;
      text.textContent = scrambleText(code, progress, randomGlyph);
      if (progress < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>

<style>
  /* Direction A · "Señal" (designs/013-not-found-page/design.md). Tokens only, mobile first. */
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    min-height: calc(var(--hero-min-height) - var(--nav-height));
    padding-block: var(--space-section);
    padding-inline: var(--space-gutter);
    text-align: center;
  }

  .not-found-code {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--not-found-code-size);
    line-height: 1;
    font-weight: var(--text-display-weight);
    letter-spacing: var(--text-display-tracking);
    text-shadow: var(--shadow-glow-text);
  }

  .not-found-message {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--about-text-max-width);
  }

  .not-found-message h1 {
    margin: 0;
    text-wrap: balance;
  }

  .not-found-line {
    margin: 0;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .not-found-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-height);
    padding-inline: var(--control-padding-x);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background-color: var(--color-secondary-bg);
    color: var(--color-text);
    font-size: var(--control-font-size);
    font-weight: var(--control-font-weight);
    text-decoration: none;
  }

  .not-found-arrow {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    fill: none;
    stroke: currentColor;
    stroke-width: var(--icon-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--color-text-muted);
  }

  .not-found-link:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-glow-secondary);
    color: var(--color-text);
  }

  .not-found-link:hover .not-found-arrow,
  .not-found-link:focus-visible .not-found-arrow {
    color: var(--color-glow);
  }

  .not-found-link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  /* M-2: the link changes smoothly only without reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .not-found-link,
    .not-found-arrow {
      transition:
        border-color var(--duration-fast) var(--ease-out),
        box-shadow var(--duration-fast) var(--ease-out),
        color var(--duration-fast) var(--ease-out);
    }
  }
</style>
