---
/*
 * Header of the 404 page (designs/013-not-found-page/design.md): only the brand, linking to the
 * home. The section links of the navigation are anchors of the home, so they are left out.
 */
import SiteBrand from './SiteBrand.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;
---

<header class="brand-header">
  <div class="brand-header-inner">
    <SiteBrand name={name} href="/" />
  </div>
</header>

<style>
  /* Direction A · "Señal" (designs/013-not-found-page/design.md). Tokens only; not fixed. */
  .brand-header {
    background-color: var(--color-nav-bg);
    border-bottom: var(--border-width) solid var(--color-border);
    padding-inline: var(--space-gutter);
  }

  .brand-header-inner {
    display: flex;
    align-items: center;
    min-height: var(--nav-height);
    max-width: var(--section-max-width);
    margin-inline: auto;
  }
</style>
