---
/*
 * Main navigation, direction A · "Índice" (designs/010-navigation/design.md): skip link, brand
 * with the initials of the profile name, "Menú" button (hidden until the navigation script runs)
 * and the numbered section links. Without JavaScript the list is always visible.
 */
import { initialsOf, NAV_LINKS } from '../lib/navigation';

interface Props {
  name: string;
}

const { name } = Astro.props;
const listId = 'site-nav-list';
const number = (index: number) => String(index + 1).padStart(2, '0');
---

<header class="site-nav">
  <a class="site-nav-skip" href="#contenido"
    ><span class="site-nav-marker" aria-hidden="true"></span><span class="site-nav-skip-arrow" aria-hidden="true">↓</span
    >Saltar al contenido</a
  >

  <div class="site-nav-inner">
    <a class="site-nav-brand" href="#top"
      ><span class="site-nav-marker" aria-hidden="true"></span><span class="site-nav-initials" aria-hidden="true"
        >{initialsOf(name)}</span
      ><span class="site-nav-name">{name}</span></a
    >

    <button class="site-nav-toggle" type="button" hidden aria-expanded="false" aria-controls={listId}>
      <svg class="site-nav-toggle-icon" viewBox="0 0 16 16" aria-hidden="true">
        <path class="site-nav-toggle-open" d="M2.5 5.5h11M2.5 10.5h11"></path>
        <path class="site-nav-toggle-close" d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path>
      </svg>
      Menú
    </button>

    <nav class="site-nav-links" aria-label="Principal">
      <ul id={listId}>
        {
          NAV_LINKS.map(({ label, anchor }, index) => (
            <li>
              <a href={`#${anchor}`}>
                <span class="site-nav-marker" aria-hidden="true" />
                <span class="site-nav-number">{number(index)}</span> <span class="site-nav-label">{label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
