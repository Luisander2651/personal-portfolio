---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import SeoHead from '../components/SeoHead.astro';
import type { PersonProfile } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Search engine and sharing metadata (specs/012-seo-metadata); omitted, the head has none. */
  seo?: { profile: PersonProfile; site: URL | string };
  /** Asks search engines not to index the page (the 404, specs/013-not-found-page). */
  noindex?: boolean;
}

/** Same value as `--color-bg` (a meta tag cannot read CSS variables; a test keeps them equal). */
const THEME_COLOR = '#05070D';

const { title, description, seo, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={THEME_COLOR} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {seo && <SeoHead title={title} description={description} profile={seo.profile} site={seo.site} />}
    <Font cssVariable="--font-geist" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body>
    <slot />
  </body>
</html>
